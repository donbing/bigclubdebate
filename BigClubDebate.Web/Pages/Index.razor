@page "/"

@using BigClubDebate.Data
@using BigClubDebate.Data.Model.DataTypes
@using BigClubDebate.Web.Data

@inject WittyTagLineGenerator TagGenerator
@inject Teams AllTeams
@inject IJSRuntime JsRuntime

@if (Team1 == null || Team2== null)
{
    <p><em>Loading...</em></p>
}
else
{
    <section class="masthead fw-block" style="margin-top: 82px;">
        <div class="container">
            <p>a statistics website to determine, once and for all who is the bigger club</p>
            <br />
            <h1>
                <select id="team1Select" value="@Team1Name" @onchange="OnTeam1NameChanged">
                    @foreach (var team in AllTeams)
                    {
                        <option value="@team.MainName" disabled="@(Team2Name == team.MainName)">@team.NickName</option>
                    }
                </select>
                <span>VS</span>
                <select id="team2Select" value="@Team2Name" @onchange="OnTeam2NameChanged">
                    @foreach (var team in AllTeams)
                    {
                        <option value="@team.MainName" disabled="@(Team1Name == team.MainName)">@team.NickName</option>
                    }
                </select>
            </h1>
            @if (Team1.HasImage)
            {
                <img class="main-img team1" src="images/badges/@Team1.ImageName" alt="@Team1.MainName badge" />
            }
            @if (Team2.HasImage)
            {
                <img class="main-img team2" src="images/badges/@Team2.ImageName" alt="@Team2.MainName badge" />
            }
            <p class="tagline">@tagLine</p>
            <p class="global-date">
                since
                <select class="year-select" @bind="GlobalFilterYear" @bind:after="OnYearChanged">
                    @for (int y = DateTime.Now.Year; y >= 1945; y--)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
            </p>
        </div>
    </section>

    <BigGamePointsSection/>

    <HeadToHeadSection Team1Name="Team1" Team2Name="Team2" DatesFilter="GlobalFilter" />
    <LeagueSection Team1Name="Team1" Team2Name="Team2" DatesFilter="GlobalFilter" />
    <LeagueCupSection Team1Name="Team1" Team2Name="Team2" DatesFilter="GlobalFilter" />
    <FaCupSection Team1Name="Team1" Team2Name="Team2" DatesFilter="GlobalFilter" />
    <ChampionsLeagueSection Team1Name="Team1" Team2Name="Team2" DatesFilter="GlobalFilter" />
    <EuropaLeagueSection Team1Name="Team1" Team2Name="Team2" DatesFilter="GlobalFilter" />
    <ConferenceLeagueSection Team1Name="Team1" Team2Name="Team2" DatesFilter="GlobalFilter" />
}

@code {

    public TeamName Team1 { get; set; }
    public TeamName Team2 { get; set; }
    public DatesFilter GlobalFilter { get; set; } = new DatesFilter(null) { Est1 = new DateTime(1945, 1, 1) };
    public int GlobalFilterYear { get; set; } = 1945;

    private void OnYearChanged()
    {
        GlobalFilter.Est1 = new DateTime(GlobalFilterYear, 1, 1);
        LoadData();
    }

    public string Team1Name => Team1?.MainName ?? AllTeams.SheffUtd.MainName;
    public string Team2Name => Team2?.MainName ?? AllTeams.SheffWeds.MainName;

    private async Task OnTeam1NameChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (Team1?.MainName != value)
        {
            Team1 = AllTeams.FirstOrDefault(x => x.MainName == value);
            await LoadData();
        }
    }

    private async Task OnTeam2NameChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (Team2?.MainName != value)
        {
            Team2 = AllTeams.FirstOrDefault(x => x.MainName == value);
            await LoadData();
        }
    }

    string tagLine => TagGenerator.ForTeams(Team1, Team2);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Team1 = AllTeams.SheffUtd;
            Team2 = AllTeams.SheffWeds;
            await LoadData();
            StateHasChanged();
        }
    }

    async Task LoadData()
    {
        await JsRuntime.InvokeVoidAsync("setbackground", Team1.BackGroundName ?? "stadium.jpg");
    }
}

